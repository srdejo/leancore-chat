# Copy to .env and fill in. .env is git-ignored: never commit a real key.

# Bot providers through Spring AI, tried in order: Anthropic first, OpenAI when Anthropic has no key,
# fails or times out. With neither key the chat still works and the bot answers "not available".
ANTHROPIC_API_KEY=
# Default model; claude-haiku-4-5 is a cheaper option for a narrow-scope bot.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
# Blank = the Spring AI default OpenAI model (printed in the backend log at startup).
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL password (user chat, database chat_db).
DB_PASSWORD=chat

# Host ports. Change them if another project already uses them.
DB_HOST_PORT=5432
BACKEND_HOST_PORT=8080
USER_APP_PORT=4200
ADMIN_APP_PORT=4300
